  "query": "\n            SELECT id, participant_a, participant_b, last_message_id, last_message_at, created_at\n            FROM conversations\n            WHERE participant_a = $1 OR participant_b = $1\n            ORDER BY last_message_at DESC NULLS LAST\n            LIMIT $2\n            ",
