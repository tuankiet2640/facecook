  "db_name": "PostgreSQL",
  "query": "\n            UPDATE users\n            SET\n                display_name = COALESCE($2, display_name),\n                bio = COALESCE($3, bio),\n                avatar_url = COALESCE($4, avatar_url),\n                updated_at = NOW()\n            WHERE id = $1\n            RETURNING id, username, email, display_name, bio, avatar_url,\n                      follower_count, following_count, post_count, is_verified,\n                      created_at, updated_at\n            ",
